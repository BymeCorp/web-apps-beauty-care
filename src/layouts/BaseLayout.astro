---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Aurelia Skin Clinic [DEMO] — Booking & AI CS Klinik Kecantikan | Byme Corporate",
  description = "Live demo sistem showcase, booking slot otomatis ke Google Sheet Sandbox, dan asisten AI CS non-medis untuk klinik kecantikan.",
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-canvas text-ink antialiased overflow-x-hidden pb-20 md:pb-0">
    <slot />
  </body>
</html>
