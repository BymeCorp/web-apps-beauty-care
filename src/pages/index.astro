---
import AiChatDrawer from "../components/AiChatDrawer";
import BookingForm from "../components/BookingForm";
import CatalogFilter from "../components/CatalogFilter";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATALOG } from "../lib/validate";

export const prerender = false;

const sheetUrl =
  import.meta.env.PUBLIC_DEMO_SHEET_URL ||
  (import.meta.env.DEMO_SPREADSHEET_ID
    ? `https://docs.google.com/spreadsheets/d/${import.meta.env.DEMO_SPREADSHEET_ID}/edit`
    : "#booking");
const waRaw = (
  import.meta.env.PUBLIC_DEMO_WA_NUMBER || "6281234567890"
).replace(/\D/g, "");
const bymeWaUrl = `https://wa.me/${waRaw}?text=${encodeURIComponent(
  "Halo Byme Corporate, saya tertarik sistem website booking + Google Sheets + AI CS untuk klinik kami.",
)}`;

const sampleSheetRows = [
  {
    code: "BK-8K2M4Q",
    slot: "14 Nov • 14:00",
    name: "Rina L.",
    treatment: "Pico Laser",
    fresh: true,
  },
  {
    code: "BK-3TQ9ZD",
    slot: "12 Nov • 10:00",
    name: "Dina P.",
    treatment: "Hydra Glow",
    fresh: false,
  },
  {
    code: "BK-7XN2KL",
    slot: "11 Nov • 16:00",
    name: "Sari W.",
    treatment: "Chem. Peel",
    fresh: false,
  },
];
---

<BaseLayout>
  <div class="bg-ink px-4 py-2 text-center text-[10px] font-bold tracking-[0.14em] text-canvas uppercase">
    LIVE DEMO BYME CORPORATE · AURELIA SKIN CLINIC [DEMO]
  </div>

  <header class="sticky top-0 z-30 border-b border-border bg-surface/95 backdrop-blur-xs">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5 md:px-6 lg:px-8">
      <div class="flex items-center gap-2.5 min-w-0">
        <a href="#top" class="font-display text-base font-bold text-ink sm:text-lg whitespace-nowrap">
          Aurelia Skin Clinic
        </a>
        <span class="rounded-md bg-terracotta px-2 py-0.5 text-[10px] font-bold text-white shrink-0">
          [DEMO]
        </span>
      </div>

      <nav class="hidden items-center gap-6 text-xs font-semibold text-ink lg:flex" aria-label="Navigasi utama">
        <a href="#alur" class="hover:text-terracotta transition-colors">Alur Demo</a>
        <a href="#katalog" class="hover:text-terracotta transition-colors">Layanan</a>
        <a href="#booking" class="hover:text-terracotta transition-colors">Booking</a>
        <a href="#kontak" class="hover:text-terracotta transition-colors">Kontak</a>
      </nav>

      <a
        href="#booking"
        class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-terracotta px-4 text-xs font-semibold text-white hover:bg-terracotta-hover transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta shrink-0"
      >
        <span class="sm:hidden">Booking</span>
        <span class="hidden sm:inline">Booking Slot Sekarang</span>
      </a>
    </div>
  </header>

  <main id="top">
    <section class="mx-auto max-w-6xl px-4 pt-8 pb-10 md:px-6 md:pt-12 lg:px-8 lg:pt-14">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="inline-block rounded-full bg-sage-tint px-3 py-1 text-[11px] font-semibold text-sage">
            Klinik Estetika & Dermatologi [DEMO]
          </span>
          <h1 class="mt-4 font-display text-2xl font-bold text-ink leading-[1.3] sm:text-3xl lg:text-[34px]">
            Kulit Terawat Dimulai dari Konsultasi yang Jelas, dan Booking Tanpa Antre.
          </h1>
          <p class="mt-4 max-w-xl text-sm text-muted leading-relaxed">
            8 layanan harga terbuka, form booking ringkas, dan konfirmasi langsung tercatat di Google Sheet Anda — bukan chat manual yang terlewat tengah malam.
          </p>

          <div class="mt-5 inline-flex max-w-full items-center rounded-full bg-warm px-4 py-2 text-xs font-semibold text-ink tabular-nums">
            Penanggung Jawab Demo: dr. Nadya Aurelia, Sp.KK [DEMO] · Buka 09:00–20:00 WIB
          </div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="#booking"
              class="inline-flex min-h-[48px] items-center justify-center rounded-lg bg-terracotta px-6 text-sm font-semibold text-white hover:bg-terracotta-hover transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
            >
              Booking Slot Sekarang
            </a>
            <a
              href={sheetUrl}
              target={sheetUrl.startsWith("http") ? "_blank" : undefined}
              rel={sheetUrl.startsWith("http") ? "noopener noreferrer" : undefined}
              class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-ink bg-surface px-5 text-xs font-semibold text-ink hover:bg-warm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
            >
              Lihat Google Sheet Demo ->
            </a>
          </div>
        </div>

        <aside class="lg:col-span-5" aria-label="Pratinjau Live Google Sheet Demo">
          <div class="rounded-xl border border-border bg-surface p-4 sm:p-5">
            <div class="rounded-md border border-dashed border-subtle bg-canvas px-3 py-2.5 text-center text-[11px] text-muted">
              [PREVIEW LIVE — baris hasil booking Anda muncul di Google Sheet ini]
            </div>

            <div class="mt-3.5 flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold tracking-wider text-sage uppercase">LIVE GOOGLE SHEET</span>
              <span class="rounded-full border border-sage bg-sage-tint px-2.5 py-0.5 text-[10px] font-bold text-sage">
                READ-ONLY
              </span>
            </div>

            <div class="mt-3 overflow-x-auto">
              <table class="w-full min-w-[320px] text-left text-[11px] tabular-nums">
                <thead>
                  <tr class="bg-ink text-canvas">
                    <th class="rounded-l px-2 py-1.5 font-semibold">KODE</th>
                    <th class="px-2 py-1.5 font-semibold">JADWAL</th>
                    <th class="px-2 py-1.5 font-semibold">NAMA</th>
                    <th class="rounded-r px-2 py-1.5 font-semibold">LAYANAN</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {sampleSheetRows.map((row) => (
                    <tr class={row.fresh ? "bg-success-tint font-semibold text-ink" : "text-ink"}>
                      <td class="px-2 py-2">{row.code}</td>
                      <td class="px-2 py-2">{row.slot}</td>
                      <td class="px-2 py-2">{row.name}</td>
                      <td class="px-2 py-2">{row.treatment}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="mt-3 flex items-center justify-between gap-2">
              <span class="rounded-full bg-terracotta px-2.5 py-0.5 text-[10px] font-bold text-white">
                BARIS BARU
              </span>
              <span class="text-[11px] text-muted tabular-nums">Sinkron real-time &lt; 2 detik</span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section id="alur" class="border-y border-border bg-warm/70 py-8 md:py-10">
      <div class="mx-auto max-w-6xl px-4 md:px-6 lg:px-8">
        <h2 class="text-xs font-bold tracking-wider text-ink uppercase">
          Alur Booking Demo — 3 Langkah, Tanpa Telepon
        </h2>
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="rounded-xl border border-border bg-surface p-5">
            <span class="font-display text-2xl font-bold text-terracotta tabular-nums">01</span>
            <h3 class="mt-2 text-sm font-bold text-ink">Pilih Treatment</h3>
            <p class="mt-1 text-xs text-muted leading-relaxed">
              Lihat durasi & harga IDR terbuka di katalog. Ketuk kartu untuk langsung ke form.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-surface p-5">
            <span class="font-display text-2xl font-bold text-terracotta tabular-nums">02</span>
            <h3 class="mt-2 text-sm font-bold text-ink">Pilih Tanggal & Slot</h3>
            <p class="mt-1 text-xs text-muted leading-relaxed">
              Slot 60 menit, 09:00–19:00 WIB. Kalender & chip jam ramah jempol, tanpa negosiasi.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-surface p-5">
            <span class="font-display text-2xl font-bold text-terracotta tabular-nums">03</span>
            <h3 class="mt-2 text-sm font-bold text-ink">Masuk Google Sheet</h3>
            <p class="mt-1 text-xs text-muted leading-relaxed">
              Kode BK-XXXX tampil otomatis & baris baru langsung tercatat di Sheet demo Anda.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="katalog" class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-12 lg:px-8">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="font-display text-2xl font-bold text-ink">Layanan — Pilih 1 untuk Booking</h2>
          <p class="mt-1 text-xs text-muted">Klik kartu mana saja untuk mengisi otomatis formulir booking di bawah.</p>
        </div>
        <span class="text-xs font-medium text-muted tabular-nums">8 layanan aktif · harga tnum</span>
      </div>

      <div class="mt-5">
        <CatalogFilter client:load items={[...CATALOG]} />
      </div>

      <div class="mt-8 flex flex-col items-start justify-between gap-4 rounded-xl bg-sage-tint p-5 sm:flex-row sm:items-center">
        <p class="text-xs font-semibold text-sage leading-relaxed">
          Bukti langsung: setiap booking demo menambah 1 baris baru di Google Sheet sandbox Anda — cek langsung setelah kirim.
        </p>
        <a
          href={sheetUrl}
          target={sheetUrl.startsWith("http") ? "_blank" : undefined}
          rel={sheetUrl.startsWith("http") ? "noopener noreferrer" : undefined}
          class="inline-flex min-h-[44px] shrink-0 items-center justify-center rounded-lg bg-ink px-5 text-xs font-semibold text-white hover:opacity-90 transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
        >
          Buka Sheet Sandbox
        </a>
      </div>
    </section>

        <section id="booking" class="border-t border-border bg-surface/60 py-10 md:py-12">
      <div class="mx-auto max-w-6xl px-4 md:px-6 lg:px-8">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="font-display text-2xl font-bold text-ink">Booking Slot (Demo) — 3 Kolom Saja</h2>
            <p class="mt-1 text-xs text-muted">
              Pilih tanggal, slot jam WIB, nama &amp; nomor WhatsApp untuk simulasi langsung ke Google Sheet Sandbox.
            </p>
          </div>
          <span class="text-xs font-medium text-muted tabular-nums">Validasi server &bull; tanpa hapus input saat error</span>
        </div>
        <div class="mt-6">
          <BookingForm client:load items={[...CATALOG]} sheetUrl={sheetUrl} waNumber={waRaw} />
        </div>
      </div>
    </section>
  </main>

  <AiChatDrawer client:load waNumber={waRaw} />

  <footer id="kontak" class="bg-ink text-canvas">
    <div class="mx-auto max-w-6xl px-4 py-10 md:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="font-display text-lg font-bold text-canvas">Aurelia Skin Clinic</span>
            <span class="rounded bg-terracotta px-2 py-0.5 text-[10px] font-bold text-white">[DEMO]</span>
          </div>
          <p class="mt-2 text-xs text-subtle leading-relaxed">
            Jl. Senopati No. 48, Jakarta Selatan [DEMO]
            <br />
            Senin–Minggu · 09:00–20:00 WIB (slot 09:00–19:00 WIB)
          </p>
        </div>

        <div class="text-xs space-y-2">
          <p class="font-bold tracking-wider text-canvas uppercase">Navigasi Demo</p>
          <ul class="space-y-1.5 text-subtle">
            <li><a href="#katalog" class="hover:text-canvas">Katalog Treatment (8)</a></li>
            <li><a href="#booking" class="hover:text-canvas">Booking Slot Demo</a></li>
            <li>
              <a
                href={sheetUrl}
                target={sheetUrl.startsWith("http") ? "_blank" : undefined}
                rel={sheetUrl.startsWith("http") ? "noopener noreferrer" : undefined}
                class="hover:text-canvas"
              >
                Google Sheet Demo Sandbox
              </a>
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-muted/40 bg-surface/5 p-4">
          <p class="text-[11px] font-bold tracking-wider text-canvas uppercase">
            Portofolio Byme Corporate
          </p>
          <p class="mt-1.5 text-xs text-subtle leading-relaxed">
            Ingin website booking otomatis + Google Sheets + asisten AI CS seperti ini untuk klinik Anda?
          </p>
          <a
            href={bymeWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex min-h-[44px] items-center justify-center rounded-lg bg-terracotta px-4 text-xs font-semibold text-white hover:bg-terracotta-hover transition-colors"
          >
            Konsultasi Implementasi ->
          </a>
        </div>
      </div>

      <div class="mt-8 flex flex-col justify-between gap-2 border-t border-muted/30 pt-6 text-[11px] text-subtle sm:flex-row">
        <span>Brought to you by Byme Corporate — Portfolio Mini Demo B2B (2026).</span>
        <span>AI CS non-medis · Tanpa data pasien nyata · Tanpa emoji</span>
      </div>
    </div>
  </footer>
</BaseLayout>
